{
  "name": "obsidian-project-hub",
  "version": "1.0.0",
  "description": "Project management for Obsidian: work items, sprints, boards, timeline, charts and rollups — all local.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0",
    "linkedom": "^0.18.0"
  }
}
